  {"id":"functions-basic-01","chapter_id":"functions","topic":"Тооны логарифм","level":"basic","criteria":["3.1"],"prompt":"log₂8-ийн утгыг ол.","answer":"3","points":1,"explanation":"2³=8 тул log₂8=3.","hint":"2-ыг хэдэн зэрэгт дэвшүүлэхэд 8 гарах вэ?"},
  {"id":"functions-basic-02","chapter_id":"functions","topic":"Логарифмын чанар","level":"basic","criteria":["3.1"],"prompt":"log₅25-ийн утгыг ол.","answer":"2","points":1,"explanation":"5²=25 тул логарифм 2.","hint":"Логарифмын тодорхойлолтыг ашигла."},
